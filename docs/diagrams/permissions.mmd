%% ============================================================
%% MotanOS — Conceptual Authorization Model (RBAC)
%% Source of truth: docs/27_PERMISSIONS.md · DEC-002 · permission-matrix.md
%% Scope: roles · permissions · actions · resources
%% Ownership: BR-0016 · permission-matrix.md
%% ============================================================

flowchart TB

    %% ------------------------------------------------------------
    %% Official roles (DEC-002) — no synonyms
    %% ------------------------------------------------------------
    subgraph ACTORS["Actors"]
        direction TB
        GUEST["Guest"]
        MEMBER["Member"]
        SOCIO["Socio"]
        ORGANIZER["Organizer"]
        STAFF["Staff"]
        MANAGER["Manager"]
        CLUB_ADMIN["Club Admin"]
        PLATFORM_ADMIN["Platform Admin"]

        GUEST --> MEMBER
        MEMBER --> SOCIO
        MEMBER --> ORGANIZER
        MEMBER --> STAFF
        STAFF --> MANAGER
        MANAGER --> CLUB_ADMIN
        CLUB_ADMIN --> PLATFORM_ADMIN
    end

    %% ------------------------------------------------------------
    %% RBAC core — no direct user → resource links
    %% ------------------------------------------------------------
    subgraph RBAC["RBAC Model"]
        direction TB
        USER["USER"]
        ROLE["ROLE"]
        PERMISSION["PERMISSION"]

        USER -->|"has one or more"| ROLE
        ROLE -->|"contains"| PERMISSION
    end

    %% ------------------------------------------------------------
    %% Actions granted by permissions
    %% ------------------------------------------------------------
    subgraph ACTIONS["Actions"]
        direction LR
        READ["READ"]
        CREATE["CREATE"]
        UPDATE["UPDATE"]
        DELETE["DELETE"]
        APPROVE["APPROVE"]
        PUBLISH["PUBLISH"]
        CONFIGURE["CONFIGURE"]
        EXPORT["EXPORT"]
    end

    %% ------------------------------------------------------------
    %% Protected resources
    %% ------------------------------------------------------------
    subgraph RESOURCES["Resources"]
        direction TB

        subgraph SPORT["Sport Domains"]
            direction LR
            BOOKINGS["BOOKINGS"]
            GOLF["GOLF"]
            PADEL["PADEL"]
            FOOTBALL["FOOTBALL"]
            BILLIARD["BILLIARD"]
            DARTS["DARTS"]
        end

        subgraph OPS["Club Operations"]
            direction LR
            RESTAURANT["RESTAURANT"]
            MENU["MENU"]
            EVENTS["EVENTS"]
            TOURNAMENTS["TOURNAMENTS"]
            MEMBERS["MEMBERS"]
            PROFILE["PROFILE"]
            PAYMENTS["PAYMENTS"]
        end

        subgraph PLATFORM["Platform Services"]
            direction LR
            CMS["CMS"]
            NOTIFICATIONS["NOTIFICATIONS"]
            AUTOMATIONS["AUTOMATIONS"]
            ANALYTICS["ANALYTICS"]
            SETTINGS["SETTINGS"]
        end
    end

    %% ------------------------------------------------------------
    %% Authorization flow
    %% USER → ROLE → PERMISSION → ACTION → RESOURCE
    %% ------------------------------------------------------------
    ACTORS -->|"maps to"| USER
    PERMISSION -->|"allows"| ACTIONS
    ACTIONS -->|"on"| RESOURCES

    %% Scope (DEC-001 single-tenant v1):
    %% Guest          → public content only
    %% Member/Socio   → own data + authorized features
    %% Organizer      → own experiences/matches
    %% Staff          → operational tasks
    %% Manager        → daily operations
    %% Club Admin     → club of this deployment
    %% Platform Admin → platform operations
