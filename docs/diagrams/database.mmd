%% ============================================================
%% MotanOS — High-Level Data Model (ER)
%% Source of truth: docs/00 → docs/53
%% Scope: entities · relationships · cardinalities
%% BOOKING.status availability-blocking:
%%   Draft|Pending|PaymentPending|Confirmed|CheckedIn|InProgress
%% Non-blocking: Waitlisted|Completed|Cancelled|NoShow|Expired
%% Not SQL · not migrations · not RLS · not full columns
%% ============================================================

erDiagram
    %% ========================================================
    %% IDENTITY
    %% ========================================================
    AUTH_USER ||--|| USER : "maps to"
    USER ||--|| PROFILE : "has"
    USER ||--o{ USER_ROLE : "assigned"
    ROLE ||--o{ USER_ROLE : "includes"
    ROLE }o--o{ PERMISSION : "grants"
    USER ||--o| USER_PREFERENCE : "has"

    %% ========================================================
    %% MEMBERSHIPS
    %% ========================================================
    MEMBERSHIP_PLAN ||--o{ MEMBERSHIP : "defines"
    USER ||--o{ MEMBERSHIP : "holds"

    %% ========================================================
    %% FACILITIES & BOOKABLE RESOURCES
    %% ========================================================
    FACILITY ||--o{ RESOURCE : "contains"
    RESOURCE ||--o{ AVAILABILITY_RULE : "governed by"
    RESOURCE ||--o{ BOOKING : "reserved as"
    RESOURCE ||--o{ WAITLIST_ENTRY : "queues"

    %% ========================================================
    %% UNIFIED BOOKING ENGINE
    %% ========================================================
    USER ||--o{ BOOKING : "owns"
    BOOKING ||--o{ BOOKING_PARTICIPANT : "includes"
    USER ||--o{ BOOKING_PARTICIPANT : "joins"
    USER ||--o{ WAITLIST_ENTRY : "joins"
    BOOKING ||--o| CHECK_IN : "confirmed by"
    USER ||--o{ CHECK_IN : "performs"
    %% Intentional cycle: EVENT ↔ EXPERIENCE ↔ BOOKING (domain overlap)
    EXPERIENCE ||--o{ BOOKING : "may generate"
    EVENT ||--o{ BOOKING : "may generate"

    %% ========================================================
    %% SOCIAL EXPERIENCE ENGINE
    %% ========================================================
    USER ||--o{ EXPERIENCE : "creates"
    EXPERIENCE ||--o{ EXPERIENCE_PARTICIPANT : "includes"
    USER ||--o{ EXPERIENCE_PARTICIPANT : "joins"
    EXPERIENCE ||--o{ INVITATION : "invites via"
    USER ||--o{ INVITATION : "sends"
    USER ||--o{ INVITATION : "receives"
    USER ||--o{ GROUP : "creates"
    GROUP ||--o{ GROUP_MEMBER : "includes"
    USER ||--o{ GROUP_MEMBER : "belongs"
    USER ||--o{ FRIENDSHIP : "requests"
    USER ||--o{ FRIENDSHIP : "accepts"

    %% ========================================================
    %% GOLF
    %% ========================================================
    BOOKING ||--o| GOLF_ROUND : "may start"
    GOLF_ROUND ||--o| GOLF_SCORECARD : "has"
    GOLF_ROUND ||--o{ GOLF_PLAYER : "includes"
    USER ||--o{ GOLF_PLAYER : "plays as"

    %% ========================================================
    %% PADEL
    %% ========================================================
    BOOKING ||--o| PADEL_MATCH : "may start"

    %% ========================================================
    %% FOOTBALL 7
    %% ========================================================
    BOOKING ||--o| FOOTBALL_MATCH : "may start"
    FOOTBALL_MATCH ||--o{ FOOTBALL_TEAM : "includes"

    %% ========================================================
    %% BILLIARD
    %% ========================================================
    BOOKING ||--o| BILLIARD_MATCH : "may start"

    %% ========================================================
    %% DARTS
    %% ========================================================
    BOOKING ||--o| DARTS_MATCH : "may start"

    %% ========================================================
    %% EVENTS (distinct from EXPERIENCE)
    %% ========================================================
    EVENT ||--o{ EVENT_REGISTRATION : "has"
    USER ||--o{ EVENT_REGISTRATION : "registers"
    EVENT }o--o| EXPERIENCE : "may relate"

    %% ========================================================
    %% TOURNAMENTS
    %% ========================================================
    TOURNAMENT ||--o{ TOURNAMENT_ENTRY : "has"
    USER ||--o{ TOURNAMENT_ENTRY : "enters"
    TOURNAMENT ||--o{ TOURNAMENT_MATCH : "schedules"
    TOURNAMENT_MATCH ||--o| TOURNAMENT_RESULT : "produces"

    %% ========================================================
    %% RESTAURANT & DIGITAL MENU
    %% ========================================================
    RESTAURANT ||--o{ DINING_TABLE : "has"
    %% RESOURCE 1 — DINING_TABLE 0..1 (not every resource is a table)
    RESOURCE ||--o| DINING_TABLE : "specialized as"
    RESTAURANT ||--o{ MENU : "publishes"
    MENU ||--o{ MENU_CATEGORY : "contains"
    MENU_CATEGORY ||--o{ MENU_ITEM : "contains"
    MENU_ITEM ||--o{ MENU_ITEM_ALLERGEN : "tagged"
    ALLERGEN ||--o{ MENU_ITEM_ALLERGEN : "applies"
    USER ||--o{ ORDER : "places"
    BOOKING ||--o| ORDER : "may include"
    ORDER ||--o{ ORDER_ITEM : "contains"
    MENU_ITEM ||--o{ ORDER_ITEM : "ordered as"

    %% ========================================================
    %% PAYMENTS (independent · clean associations)
    %% ========================================================
    USER ||--o{ PAYMENT : "pays"
    BOOKING ||--o{ PAYMENT : "settled by"
    ORDER ||--o{ PAYMENT : "settled by"
    MEMBERSHIP ||--o{ PAYMENT : "settled by"
    PAYMENT ||--o{ REFUND : "may refund"
    PAYMENT ||--o| INVOICE : "invoiced as"

    %% ========================================================
    %% COMMUNICATION
    %% ========================================================
    USER ||--o{ NOTIFICATION : "receives"
    USER ||--|| NOTIFICATION_PREFERENCE : "configures"
    USER ||--o{ RECOMMENDATION : "receives"

    %% ========================================================
    %% CMS
    %% ========================================================
    CONTENT ||--o{ CONTENT_VERSION : "versioned as"
    CONTENT ||--o{ MEDIA_ASSET : "uses"
    USER ||--o{ CONTENT : "may author"
    USER ||--o{ MEDIA_ASSET : "may upload"

    %% ========================================================
    %% SYSTEM
    %% ========================================================
    USER ||--o{ AUDIT_LOG : "actions"
    AUTOMATION_RUN }o--o| USER : "may target"
    AUTOMATION_RUN }o--o| BOOKING : "may act on"
    AUTOMATION_RUN }o--o| NOTIFICATION : "may trigger"

